# ============================================================
# Email AI Agent — Environment Configuration
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------
# IMAP (Email Server)
# ----------------------------
IMAP_HOST=mailstore.iitd.ac.in
IMAP_PORT=993
IMAP_USER=your_iitd_kerberos_id
IMAP_PASSWORD=your_iitd_password
IMAP_MAILBOX=INBOX

# ----------------------------
# Google Gemini
# ----------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------
# Neon PostgreSQL
# ----------------------------
# Get this from your Neon project dashboard → Connection Details
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ----------------------------
# Google Calendar
# ----------------------------
# Calendar ID — "primary" works for the main calendar
GOOGLE_CALENDAR_ID=primary
# Path to your OAuth2 credentials JSON downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_JSON=credentials.json
# Path where the OAuth2 token will be stored after first auth
GOOGLE_TOKEN_JSON=token.json

# ----------------------------
# Agent Behaviour
# ----------------------------
# How often to poll for new emails (minutes)
POLL_INTERVAL_MINUTES=10
# Max characters of email body to send to Gemini (keeps token usage low)
EMAIL_BODY_MAX_CHARS=3000

# ----------------------------
# Student Identity (for attachment row-matching)
# ----------------------------
# Your college/institute entry number (e.g. 2024tt10708)
STUDENT_ENTRY_NO=2024ttXXXXX
# Your full name exactly as it appears in official records
STUDENT_NAME=Your Full Name
